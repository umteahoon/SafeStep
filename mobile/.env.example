# frontend/.env · backend/.env 와 같은 Supabase 프로젝트 값
EXPO_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# backend/ Express API 주소 (끝에 /api 를 붙이지 마세요)
EXPO_PUBLIC_API_BASE_URL=https://safestep-backend.onrender.com

# 네이버 지도 (미설정 시 지도 없이 지점 목록만 표시)
EXPO_PUBLIC_NAVER_MAP_CLIENT_ID=
# 네이버 클라우드 콘솔 "Web 서비스 URL"에 등록한 주소와 동일해야 지도가 뜹니다
EXPO_PUBLIC_NAVER_MAP_WEB_URL=http://localhost

# 토스페이먼츠 결제위젯 클라이언트 키 (test_ck_...)
EXPO_PUBLIC_TOSS_CLIENT_KEY=

# 1 이면 로그인 없이 모든 화면을 둘러보는 미리보기 모드 (내 정보 탭에서 역할 전환). 실서비스에서는 반드시 비우세요.
EXPO_PUBLIC_PREVIEW_MODE=
